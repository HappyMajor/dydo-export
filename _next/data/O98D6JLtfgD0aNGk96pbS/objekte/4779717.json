construction_year_unknown":false,"condition":null,"heating_type":"Fernwärme","firing_types":"KWK regenerativ","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Verbrauchsausweis","energy_efficiency_value":119.22,"thermal_characteristic":119.22},"property_groups":[],"hide_address":true,"floorplans":[],"links":[{"id":1383601,"title":"360° Tour","url":"https://tour.ogulo.com/ktnw","is_private":true,"tags":[],"is_embedable":true}],"required_fields":[{"name":"Preis","value":"325.000 €"},{"name":"Wohnfläche ca.","value":"76 m²"},{"name":"Zimmer","value":"4"}],"optional_fields":[{"key":"dossier_link","name":"Bewertungslink","value":"https://app.maps.sprengnetter.de/view?report_id=f65cccb6-e640-4511-9067-bf8d88bd1133"},{"key":"id_ph_dossier","name":"Bewertungs-ID","value":"f65cccb6-e640-4511-9067-bf8d88bd1133"},{"key":"sprengnetter_dossier_link","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_link","value":"https://app.maps.sprengnetter.de/view?report_id=f65cccb6-e640-4511-9067-bf8d88bd1133"},{"key":"sprengnetter_dossier_id","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_id","value":"f65cccb6-e640-4511-9067-bf8d88bd1133"},{"key":"apartment_type","name":"Wohnungstyp","value":"Etagenwohnung"},{"key":"floor","name":"Etage","value":"1. OG"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"3"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"total_rent","name":"Warmmiete","value":"1.470 €"},{"key":"service_charge","name":"Nebenkosten","value":"290 €"},{"key":"heating_costs_in_service_charge","name":"Heizkosten in Nebenkosten enthalten","value":true},{"key":"rent_subsidy","name":"Hausgeld/Monat","value":"322 €"},{"key":"rental_income","name":"Mtl. Mieteinnahmen","value":"1.470 €"},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"einfach"},{"key":"balcony_space","name":"Balkon/Terrasse Fläche ca.","value":"4 m²"},{"key":"cellar","name":"Keller","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"balcony","name":"Balkon / Terrasse","value":true},{"key":"bathroom","name":"Bad","value":"Wanne, Fenster"},{"key":"construction_year","name":"Baujahr ca.","value":1959},{"key":"energy_certificate_start_date","name":"Energieausweis: Ausstellungsdatum","value":"20.06.2018"},{"key":"energy_certificate_end_date","name":"Energieausweis: gültig bis","value":"20.06.2028"},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Verbrauchsausweis"},{"key":"energy_efficiency_class","name":"Energieeffizienzklasse","value":"D"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"KWK regenerativ"},{"key":"energy_efficiency_value","name":"Energieverbrauchskennwert","value":"119,22 kWh/(m²*a)"},{"key":"heating_type","name":"Heizungsart","value":"Fernwärme"},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":1978},{"key":"base_rent","name":"Kaltmiete","value":"1.180 €"}],"custom_fields":{},"description_note":"Diese Traumwohnung überzeugt durch ihren durchdachten und funktionalen Grundriss sowie eine angenehme Wohnatmosphäre. Bereits beim Betreten gelangt man in einen zentralen Flur, von dem aus alle Räume bequem erreichbar sind – ein Schnitt, der sowohl für Familien als auch für Wohngemeinschaften ideal geeignet ist.\n\nAuf der linken Seite befindet sich das Tageslichtbad mit Badewanne, das durch das Fenster freundlich und gut belüftet ist. Direkt daneben liegt eine kompakte Küche, die funktional gestaltet ist und alles bietet, was man für den täglichen Bedarf benötigt.\n\nEbenfalls auf der linken Seite schließt sich ein weiteres Zimmer an, das sich hervorragend als Kinderzimmer, Gästezimmer oder Homeoffice eignet. Gegenüber der Eingangstür befindet sich ein zusätzliches Zimmer, das ebenfalls flexibel als Kinder- oder Arbeitszimmer genutzt werden kann.\n\nAuf der rechten Seite der Wohnung eröffnet sich ein großzügiges, lichtdurchflutetes Wohnzimmer mit Zugang zum Balkon. Dieser bietet einen schönen Blick ins Grüne und lädt zum Verweilen ein. Ein weiteres Zimmer neben dem Wohnzimmer komplettiert das Raumangebot und eignet sich ideal als Schlafzimmer.\n\nAktuell ist die Wohnung an eine Wohngemeinschaft vermietet und stellt somit eine attraktive Kapitalanlage dar – mit der Perspektive, sie zukünftig auch selbst zu beziehen.\n\nDas Gebäude wurde im Jahr 1959 errichtet. Die Beheizung erfolgt über eine Kombination aus Fernwärme und regenerativer Kraft-Wärme-Kopplung. Der Wärmeerzeuger stammt aus dem Jahr 1978. Warmwasserversorgung erfolgt über Strom.","location_note":"Die Wohnung befindet sich in angenehmer Wohnlage in Lankwitz. Das Umfeld ist geprägt von viel Grün, gewachsenen Strukturen und einer ruhigen, dennoch gut angebundenen Infrastruktur.\n\nDer nahegelegene Gemeindepark lädt zu Spaziergängen, sportlichen Aktivitäten und Erholung im Grünen ein. Einkaufsmöglichkeiten für den täglichen Bedarf, Schulen, Kitas sowie Ärzte und weitere Einrichtungen sind in kurzer Zeit erreichbar.\n\nAuch die Verkehrsanbindung ist sehr gut: Sowohl öffentliche Verkehrsmittel als auch wichtige Verkehrsachsen sind schnell erreichbar und ermöglichen eine zügige Verbindung in die umliegenden Stadtteile sowie in die Berliner Innenstadt.\n\nEine Wohnlage, die Ruhe, Natur und eine gute Infrastruktur ideal miteinander verbindet.","furnishing_note":"- Durchdachter, zentraler Grundriss\n\n- Großzügiges Wohnzimmer mit Balkonzugang\n\n- Balkon mit grünem Ausblick\n\n- Tageslichtbad mit Badewanne\n\n- Funktionale, kompakte Küche\n\n- Große, helle Fensterflächen\n\n- Fernwärme in Kombination mit regenerativer Kraft-Wärme-Kopplung\n\n- Aktuell vermietet (Wohngemeinschaft) – ideal als Kapitalanlage","other_note":"Verkäufer ist eine Privatperson. Zeitnahe Beurkundung und Abwicklung des Kaufvertrags möglich.\n\nDiese Wohnung wird für den Käufer provisionspflichtig exklusiv über uns direkt angeboten. \nDie Vermittlungsprovision beträgt 3,57 % des notariellen Kaufpreises inkl. der gesetzlichen Mehrwertsteuer.\n\nAlle weiteren Kosten des Kaufs wie die Grunderwerbssteuer (6 %) sowie Notar- und Gerichtskosten (etwa 1,5-2 %) sind vom Käufer zu bezahlen. Die Liegenschaft wird lastenfrei übergeben.\n\nAlle Angaben sind sorgfältig recherchiert und basieren auf Angaben des Verkäufers, Irrtümer vorbehalten. Erste Kontaktaufnahme bitte per E-Mail. Wir antworten binnen weniger Stunden.\n\nUm Ihnen ein noch besseres Bild von dieser Wohnung zu geben, haben wir ein detailliertes 360 Grad Video erstellt, das die Räumlichkeiten genauer zeigt. In diesem Video können Sie einen virtuellen Rundgang durch die Räumlichkeiten machen und alle Annehmlichkeiten aus verschiedenen Perspektiven betrachten. Sie erhalten bereits beim ersten Kontakt Zugang zum Datenraum mit weiteren Innen- und Außenaufnahmen sowie den ersten Objektunterlagen. Vollständige Adresse gerne auf Anfrage oder bei konkretem Kaufinteresse. \n\nBesichtigung ist zeitnah möglich. Sie erhalten nach qualifizierter Anfrage über das Internet-Portal bereits mögliche Besichtigungstermine angeboten. \n\nWir begleiten Sie auch gerne bei der Finanzierung.","service_charge":290,"heating_costs":null,"total_rent":1470,"parking_space_price":null,"deposit":null,"courtage":"3,57% vom notariellen Kaufpreis inkl. MwSt.","courtage_note":null,"condition":null,"heating_type":"Fernwärme","firing_types":"KWK regenerativ","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Verbrauchsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":4276,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":34351,"salutation":"mr","academic_title":null,"first_name":"Marcel","last_name":"Smarslik","name":"Marcel Smarslik","