":"neuwertig","heating_type":"Zentralheizung","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","energy_efficiency_value":null,"thermal_characteristic":null},"property_groups":[],"hide_address":true,"floorplans":[],"links":[],"required_fields":[{"name":"Kaltmiete","value":"1.400 €"},{"name":"Wohnfläche ca.","value":"50,35 m²"},{"name":"Zimmer","value":"2"}],"optional_fields":[{"key":"apartment_type","name":"Wohnungstyp","value":"Etagenwohnung"},{"key":"floor","name":"Etage","value":"5. OG"},{"key":"number_of_floors","name":"Etagenzahl","value":"5"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"1"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"total_rent","name":"Warmmiete","value":"1.660 €"},{"key":"service_charge","name":"Nebenkosten","value":"160 €"},{"key":"heating_costs","name":"Heizkosten","value":"100 €"},{"key":"heating_costs_in_service_charge","name":"Heizkosten in Nebenkosten enthalten","value":true},{"key":"condition","name":"Objektzustand","value":"neuwertig"},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"gehoben"},{"key":"balcony_space","name":"Balkon/Terrasse Fläche ca.","value":"4 m²"},{"key":"flooring_type","name":"Bodenbelag","value":"Parkett, Fliesen"},{"key":"pets_allowed","name":"Haustiere erlaubt","value":"Nach Vereinbarung"},{"key":"lift","name":"Personenaufzug","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"balcony","name":"Balkon / Terrasse","value":true},{"key":"bathroom","name":"Bad","value":"Wanne, Fenster"},{"key":"construction_year","name":"Baujahr ca.","value":2018},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Bedarfsausweis"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"Fernwärme"},{"key":"heating_type","name":"Heizungsart","value":"Zentralheizung"},{"key":"energy_consumption_contains_warm_water","name":"Energieverbrauch für Warmwasser enthalten","value":true},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":2018},{"key":"duplicated","name":"Translation missing: de.simple_form.labels.defaults.duplicated","value":true}],"custom_fields":{},"description_note":"- komplett neusaniertes Mehrparteienhaus\n- alle Wohnungen wurden 2018 fertig gestellt\n- Aufzug im Objekt\n\nWohnung:\n\n- Sie betreten die Wohnung über die kompakte Diele\n- rechtsseitig liegt das geräumige Wohnzimmer mit offener Wohnküche\n- neue und moderne EBK samt E-Geräten ist bereits vorhanden\n- vom Wohnzimmer aus haben Sie Zugang auf den Balkon\n- der Balkon mit ruhiger Lage zum Hinterhof bitte genügend Platz für Sitzecke o.ä.\n- gerade zu liegt das innenliegende Badezimmer\n- modernes und hochwertiges Bad mit Badewanne, Handtuchheizkörper und Waschtischamatur\n- mechanische Entlüftungsanlage vorhanden\n- kleines, verglastes Fenster verbindet das Bad mit dem Schlafzimmer und ermöglicht zusätzlichen Lichteinfall\n- linksseitig gelegen ist das schön geschnittene Schlafzimmer mit kleinem ,,Eingangsbereich\"\n- bietet genügend Platz für Bett, Schrank und Accessoires\n- zusätzlich gibt es in der Wohnung einen kleinen Hauswirtschaftsraum","location_note":"- super zentrale und beliebte Lage im Szeneviertel Berlin-Neukölln\n- prägend für das Ortsbild ist die ehemalige denkmalgeschützte Kindl-Brauerei\n- vitales Umfeld mit vielen Cafés, Restaurants und Bars\n- der ,,Kindl-Boulevard\" mit Hotel-, Dienstleistungs-, Gastronomie- sowie Einkaufsmöglichkeiten ist in 5 Min. fußläufig erreichbar\n- sowie zahlreiche andere Einkaufsmöglichkeiten und Nahversorger in direkter Umgebung\n- die U-Bahn Stationen Boddinstraße (U8) und Rathaus Neukölln (U7) in weniger als 10 Minuten fußläufig erreichbar\n- die Buslinien 104 sowie 166 sind ca. 10 Minuten entfernt (Station Morusstraße sowie Herrfurthstr.)\n- das Tempelhofer Feld befindet sich in unmittelbarer Umgebung und lädt ein zur Erholung und Freizeitgestaltung im Grünen","furnishing_note":"- in den Wohnräumen sowie in der Diele wurde Parkett verlegt\n- im Badezimmer liegen moderne und hochwertige Fliesen\n- die Fenster und die Balkontüren bestehen aus Kunststoff und besitzen moderne Wärmeisolierverglasung\n- erhöhter Schallschutz\n- WaMa-Anschluss im Badezimmer\n- einbruchssichere Wohnungseingangstür\n- Ruf-und Gegensprechanlage sowie Videotürkontrolle in der Wohnung\n- Breitbandkabelanschluss vorhanden","other_note":"Ideal für Singles oder Pärchen, Wochenendpendler mit Sinn für schönes und modernes Wohnen, die eine zentrale Lage und ein vitales Umfeld suchen!\n\nDie komplette Miete für diese vollmöblierte Wohnung beträgt 1.660.- EUR. Darin enthalten sind neben der Nettokaltmiete die pauschalen Zahlungen für Heiz- und Warmwasserkosten sowie Strom und Internet. Die Wohnung wird vorerst befristet für zwei Jahre vermietet, mit Möglichkeit der Verlängerung.\n\nDie Wohnung ist komplett möbliert, inklusive EBK mit E-Geräten, Geschirr, Besteck, Wasserkocher, Toaster, Esspressomaschine, Waschmaschine, Bett, Schränken, Sofa, 1 Esstisch, 2 Stühle, 2 Sessel...\n\nErste Kontaktaufnahme bitte per E-Mail. Wir antworten binnen weniger Stunden.","service_charge":160,"heating_costs":100,"total_rent":1660,"parking_space_price":null,"deposit":"4200","courtage":null,"courtage_note":null,"condition":"neuwertig","heating_type":"Zentralheizung","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":27.81,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":294787,"salutation":"mr","academic_title":null,"first_name":"Maximilian","last_name":"Aehlig","name":"Maximilian Aehlig","avatar":"https://i