ciency_value":168.1,"thermal_characteristic":168.1},"property_groups":[],"hide_address":true,"floorplans":[],"links":[{"id":1425584,"title":"360-Grad-Tour","url":"https://tour.ogulo.com/RP1d","is_private":false,"tags":[],"is_embedable":true}],"required_fields":[{"name":"Preis","value":"369.000 €"},{"name":"Wohnfläche ca.","value":"67,94 m²"},{"name":"Zimmer","value":"3"}],"optional_fields":[{"key":"sprengnetter_dossier_link","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_link","value":"https://app.maps.sprengnetter.de/view?report_id=8dc0a2a3-a84b-444b-90d6-a7a7a95630ba"},{"key":"sprengnetter_dossier_id","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_id","value":"8dc0a2a3-a84b-444b-90d6-a7a7a95630ba"},{"key":"apartment_type","name":"Wohnungstyp","value":"Etagenwohnung"},{"key":"floor","name":"Etage","value":"3. OG"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"2"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"rent_subsidy","name":"Hausgeld/Monat","value":"296,58 €"},{"key":"maintenance_reserve","name":"Instandhaltungsrücklage","value":"111,50 €"},{"key":"condition","name":"Objektzustand","value":"Erstbezug nach Sanierung"},{"key":"last_refurbishment","name":"Letzte Modernisierung","value":2026},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"normal"},{"key":"balcony_space","name":"Balkon/Terrasse Fläche ca.","value":"10 m²"},{"key":"lift","name":"Personenaufzug","value":true},{"key":"cellar","name":"Keller","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"balcony","name":"Balkon / Terrasse","value":true},{"key":"storeroom","name":"Abstellraum","value":true},{"key":"bathroom","name":"Bad","value":"Dusche"},{"key":"construction_year","name":"Baujahr ca.","value":1972},{"key":"energy_certificate_start_date","name":"Energieausweis: Ausstellungsdatum","value":"13.06.2018"},{"key":"energy_certificate_end_date","name":"Energieausweis: gültig bis","value":"13.06.2028"},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Verbrauchsausweis"},{"key":"energy_efficiency_class","name":"Energieeffizienzklasse","value":"F"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"Öl"},{"key":"certificate_status","name":"Translation missing: de.simple_form.labels.defaults.certificate_status","value":"ISSUED_VALID"},{"key":"energy_efficiency_value","name":"Energieverbrauchskennwert","value":"168,1 kWh/(m²*a)"},{"key":"heating_type","name":"Heizungsart","value":"Zentralheizung"},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":1990},{"key":"number_of_indoor_parking_spaces","name":"Anzahl Garagenplätze","value":"1"},{"key":"duplicated","name":"Translation missing: de.simple_form.labels.defaults.duplicated","value":true}],"custom_fields":{},"description_note":"Ihr neues Zuhause befindet sich in der dritten Etage eines gepflegten Mehrfamilienhauses in absoluter City-Lage und ist bequem per Aufzug erreichbar. Zusätzlich verfügt das Gebäude über eine Tiefgarage mit direktem Zugang zum Haus sowie einen geräumigen Fahrradkeller, der komfortablen und sicheren Abstellraum für Fahrräder bietet.\n\nAuf rund 67,94 m² Wohnfläche überzeugt die Wohnung durch eine durchdachte Raumaufteilung und ein helles, freundliches Wohnambiente.\n\nBeim Betreten gelangen Sie zunächst in einen kurzen Flur, der direkt in das großzügige Wohnzimmer führt. Von hier aus haben Sie Zugang zum sonnigen Balkon, der zum Entspannen einlädt. Auf der gegenüberliegenden Seite befindet sich die Küche.\n\nLinks vom Wohnbereich zweigt ein weiterer kleiner Flur ab, der die restlichen Räume miteinander verbindet. Hier stehen Ihnen ein geräumiges Schlafzimmer, ein weiteres Zimmer – ideal als Kinderzimmer oder Homeoffice – sowie ein modernes Badezimmer mit Dusche zur Verfügung. Zusätzlich befindet sich hier ein praktisches Abstellkämmerchen, das für weiteren Stauraum sorgt.\n\nDas Schmuckstück wurde im Jahr 2026 vollständig saniert und präsentiert sich in einem modernen, neuwertigen Zustand.\n\nDa die Wohnung leerstehend ist, eignet sie sich ideal sowohl für Eigennutzer, die kurzfristig einziehen möchten, als auch für Kapitalanleger, die eine attraktive Immobilie in gefragter Lage suchen.","location_note":"Diese Traumwohnung befindet sich in absolut begehrter Berliner Kiezlage mit gewachsener Nachbarschaft und urbanem Flair. Die Umgebung ist geprägt von charmanten Altbauten, kleinen Cafés, Restaurants, Boutiquen sowie vielfältigen Einkaufsmöglichkeiten für den täglichen Bedarf.\n\nDie Nähe zum Kurfürstendamm macht diesen Standort besonders attraktiv. Der Ku’damm zählt zu den bekanntesten Boulevards Berlins und bietet eine exzellente Auswahl an Einkaufsmöglichkeiten, Gastronomie, kulturellen Einrichtungen und Freizeitangeboten.\n\nAuch infrastrukturell ist die Lage hervorragend angebunden. Mehrere Buslinien verkehren in unmittelbarer Umgebung. Zudem sind verschiedene U-Bahn-Stationen sowie S-Bahn-Anbindungen schnell erreichbar, sodass eine optimale Verbindung in die Berliner Innenstadt, zu weiteren Bezirken sowie zum Hauptbahnhof und Flughafen besteht.\n\nMit dem Auto profitieren Sie von einer guten Anbindung an das übergeordnete Straßennetz. Wichtige Hauptverkehrsstraßen sowie die Stadtautobahn sind in kurzer Zeit erreichbar und ermöglichen eine zügige Verbindung in alle Richtungen Berlins und darüber hinaus.\n\nDie Kombination aus urbanem Leben, hervorragender Infrastruktur und hoher Lebensqualität macht diese Lage sowohl für Eigennutzer als auch für Kapitalanleger besonders interessant.","furnishing_note":"Die Wohnung überzeugt durch eine moderne und durchdachte Ausstattung. Sie verfügt über drei gut geschnittene Zimmer auf 67,94 m² Wohnfläche und befindet sich in der dritten Etage eines Hauses mit Aufzug, was einen komfortablen Zugang ermöglicht.\n\nIm Zuge der vollständigen Sanierung im Jahr 2026 wurde die Wohnung umfassend modernisiert und präsentiert sich in einem zeitgemäßen, hochwertigen Zustand. Große Fensterflächen sorgen für helle, lichtdurchflutete Räume und schaffen eine angenehme Wohnatmosphäre. Der sonnige Balkon erweitert den Wohnbereich nach außen und bietet zusätzlichen Raum zur Erholung.\n\nDas Badezimmer ist modern gestaltet und mit einer Dusche sowie einem stilvollen Stuck-Heizkörper ausgestattet. Ein separates Abstellkämmerchen innerhalb der Wohnung bietet praktischen Stauraum. Insgesamt vermittelt die Wohnung ein modernes und zugleich gemütliches Wohngefühl in einer der gefragtesten Lagen Berlins.","other_note":"Verkäufer ist eine Privatperson. Zeitnahe Beurkundung und Abwicklung des Kaufvertrags möglich.\n\nDiese Wohnung wird für den Käufer provisionspflichtig exklusiv über uns direkt angeboten. \nDie Vermittlungsprovision beträgt 3,57 % des notariellen Kaufpreises inkl. der gesetzlichen Mehrwertsteuer.\n\nAlle weiteren Kosten des Kaufs wie die Grunderwerbssteuer (6 %) sowie Notar- und Gerichtskosten (etwa 1,5-2 %) sind vom Käufer zu bezahlen. Die Liegenschaft wird lastenfrei übergeben.\n\nAlle Angaben sind sorgfältig recherchiert und basieren auf Angaben des Verkäufers, Irrtümer vorbehalten. Erste Kontaktaufnahme bitte per E-Mail. Wir antworten binnen weniger Stunden.\n\nUm Ihnen ein noch besseres Bild von dieser Wohnung zu geben, haben wir ein detailliertes 360 Grad Video erstellt, das die Räumlichkeiten genauer zeigt. In diesem Video können Sie einen virtuellen Rundgang durch die Räumlichkeiten machen und alle Annehmlichkeiten aus verschiedenen Perspektiven betrachten. Sie erhalten bereits beim ersten Kontakt Zugang zum Datenraum mit weiteren Innen- und Außenaufnahmen sowie den ersten Objektunterlagen. Vollständige Adresse gerne auf Anfrage oder bei konkretem Kaufinteresse. \n\nBesichtigung ist zeitnah möglich. Sie erhalten nach qualifizierter Anfrage über das Internet-Portal bereits mögliche Besichtigungstermine angeboten. \n\nWir begleiten Sie auch gerne bei der Finanzierung.","service_charge":null,"heating_costs":null,"total_rent":null,"parking_space_price":null,"deposit":null,"courtage":"3,57% vom notariellen Kaufpreis inkl. MwSt.","courtage_note":null,"condition":"Erstbezug nach Sanierung","heating_type":"Zentralheizung","firing_types":"Öl","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Verbrauchsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":5431,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":34351,"salutation":"mr","academic_title":null,"first_name":"Marcel","last_name":"Smarslik","name":"Marcel Smarslik","avatar":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/MKSvHYB29Xx7MfwQ555Hvaq3/thumb_Marcel-Smarslik.png","avatar_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/MKSvHYB29Xx7MfwQ555Hvaq3/Marcel-Smarslik.png","old_crm_id":"","position":"stv. Geschäftsleitung","email":"marcel.smarslik@dydo.de","phone_system_number":"0176 46142337","phone_system_numbers":[{"value":"0176 46142337","group_id":null,"position":0}],"phone":"0176 46142337","cell":"0176 46142337","public_phone":"0176 46142337","public_cell":"0176 46142337","public_email":"marcel.smarslik@dydo.de","color":"#000000","locale":"de","connected":true,"team_id":null,"department_ids":[],"abstract":null,"description":null,"custom_fields":{"qualifikation":{"value":null,"pretty_value":null}},"shop":{"id":15427,"name":"dydo Immobilien & Hausverwaltung ","color":"#2f5496","locale":"de","logo_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/logo/XuXEd9DVPkWBr3Z1VPhNG6Bf/dydo-logo-copyright.jpg","alt_logo_url":null,"watermark_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/watermark/XuXEd9DVPkWBr3Z1VPhNG6Bf/167465