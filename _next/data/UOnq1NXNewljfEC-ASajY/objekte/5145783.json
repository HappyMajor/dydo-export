 entfernt","furnishing_note":"- Echtholzparkett in allen Wohnräumen und dem Flur\n- hochwertige Fliesenspiegel in der Küche und dem Bad sowie dem Gäste-WC\n- Raumhöhe mindestens 2,78 cm\n- diese Wohnung wird vollmöbliert angeboten\n- Videogegensprechanlage mit Türöffner\n- separater Mieterkeller","other_note":"IDEAL als Alternative zum Hotel, oder für solvente Studenten, gerne auch Wochenendpendler.\n\nDie Warmmiete dieser im 3. Stock mit Aufzug gelegenen Wohnung beträgt 1.580,- €. Es handelt sich um ein unbefristetes Mietverhältnis mit Staffelmietvereinbarung, welche für Planungssicherheit auf beiden Seiten sorgt. \n\nBei Interesse schicken Sie uns bitte eine Anfrage per E-Mail. Wir antworten binnen weniger Stunden.","service_charge":140,"heating_costs":140,"total_rent":1580,"parking_space_price":null,"deposit":"3900","courtage":null,"courtage_note":null,"condition":"neuwertig","heating_type":"Zentralheizung","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":18.84,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":294787,"salutation":"mr","academic_title":null,"first_name":"Maximilian","last_name":"Aehlig","name":"Maximilian Aehlig","avatar":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/thumb_Maximilian-Aehlig.png","avatar_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/Maximilian-Aehlig.png","old_crm_id":"","position":"Vermietung/Verkauf","email":"maximilian.aehlig@dydo.de","phone_system_number":"","phone_system_numbers":[{"value":"","group_id":null,"position":0}],"phone":"030 166381115","cell":"0151 40222020","public_phone":"01514