ment":false,"energy_consumption_contains_warm_water":false,"barrier_free":false,"guest_toilet":false,"built_in_kitchen":true,"balcony":false,"garden":false,"lodger_flat":false,"rented":false,"summer_residence_practical":true,"heating_costs_in_service_charge":false,"flat_share_suitable":false,"certificate_of_eligibility_needed":false,"price_on_inquiry":false,"short_term_constructible":false,"building_permission":false,"demolition":false,"has_canteen":false,"kitchen_complete":false,"high_voltage":false,"terrace":false,"ramp":false,"auto_lift":false,"goods_lift":false,"crane_runway":false},"fields":{"construction_year":1991,"construction_year_unknown":false,"condition":"gepflegt","heating_type":"Fernwärme","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Verbrauchsausweis","energy_efficiency_value":86,"thermal_characteristic":86},"property_groups":[],"hide_address":true,"floorplans":[],"links":[{"id":1423734,"title":"360°-Tour","url":"https://tour.ogulo.com/0pez","is_private":false,"tags":[],"is_embedable":true}],"required_fields":[{"name":"Preis","value":"220.000 €"},{"name":"Wohnfläche ca.","value":"60 m²"},{"name":"Zimmer","value":"3"}],"optional_fields":[{"key":"apartment_type","name":"Wohnungstyp","value":"Etagenwohnung"},{"key":"floor","name":"Etage","value":"EG"},{"key":"number_of_floors","name":"Etagenzahl","value":"5"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"3"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"rent_subsidy","name":"Hausgeld/Monat","value":"245 €"},{"key":"condition","name":"Objektzustand","value":"gepflegt"},{"key":"last_refurbishment","name":"Letzte Modernisierung","value":2020},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"normal"},{"key":"flooring_type","name":"Bodenbelag","value":"Laminat, Fliesen"},{"key":"cellar","name":"Keller","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"summer_residence_practical","name":"Als Ferienwohnung geeignet","value":true},{"key":"bathroom","name":"Bad","value":"Wanne"},{"key":"construction_year","name":"Baujahr ca.","value":1991},{"key":"energy_certificate_start_date","name":"Energieausweis: Ausstellungsdatum","value":"31.01.2018"},{"key":"energy_certificate_end_date","name":"Energieausweis: gültig bis","value":"30.01.2028"},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Verbrauchsausweis"},{"key":"energy_efficiency_class","name":"Energieeffizienzklasse","value":"C"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"Fernwärme"},{"key":"energy_efficiency_value","name":"Energieverbrauchskennwert","value":"86 kWh/(m²*a)"},{"key":"heating_type","name":"Heizungsart","value":"Fernwärme"},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":2010},{"key":"valuation_price_from","name":"Bewertung Preis von","value":"170.000"},{"key":"valuation_price_to","name":"Bewertung Preis bis","value":"262.000"},{"key":"valuation_price","name":"Bewertung Preis","value":"206.000"},{"key":"duplicated","name":"Translation missing: de.simple_form.labels.defaults.duplicated","value":true}],"custom_fields":{},"description_note":"Zum Verkauf steht eine attraktive und sofort verfügbare 3-Zimmer-Wohnung im Berliner Ortsteil Hellersdorf. Die Wohnung befindet sich in einem gepflegten Wohnumfeld und bietet mit ca. 60 m² Wohnfläche ein komfortables Zuhause für Singles, Paare oder kleine Familien.\n\nDie Wohnung überzeugt durch einen durchdachten Grundriss mit drei gut geschnittenen Zimmern, die vielseitig genutzt werden können, beispielsweise als Wohn-, Schlaf- und Kinderzimmer oder auch als Arbeits- bzw. Gästezimmer. Große Fenster sorgen in allen Räumen für viel Tageslicht und schaffen eine besonders helle und freundliche Wohnatmosphäre.\n\nDer offene Küchenbereich integriert sich harmonisch in den Wohnraum und ermöglicht eine moderne, kommunikative Wohnsituation. \n\nDas Badezimmer ist zeitlos gestaltet und mit einer Badewanne ausgestattet, ideal zum Entspannen nach einem langen Tag. Ein Waschmaschinenanschluss befindet sich ebenfalls in der Küche, eine Waschmaschine ist bereits vorhanden und kann direkt genutzt werden.\n\nZusätzlichen Stauraum bietet ein zur Wohnung gehörender Kellerraum. Im Hinterhof steht den Bewohnern außerdem ein gemeinschaftlich nutzbarer Garten zur Verfügung, der zum Entspannen im Freien einlädt.\n\nDank der sofortigen Verfügbarkeit eignet sich die Wohnung sowohl für Eigennutzer als auch für Kapitalanleger, die eine solide und langfristig stabile Investition im Berliner Immobilienmarkt suchen.","location_note":"Die Wohnung befindet sich im östlichen Teil von Berlin im grünen und familienfreundlichen Ortsteil Hellersdorf im Bezirk Marzahn-Hellersdorf.\n\nDie Umgebung zeichnet sich durch eine ruhige Wohnlage mit viel Grün sowie eine gut entwickelte Infrastruktur aus. Einkaufsmöglichkeiten, Schulen, Kindergärten, Ärzte und gastronomische Angebote befinden sich in der näheren Umgebung und sind bequem erreichbar.\n\nBesonders hervorzuheben ist die sehr gute Anbindung an den öffentlichen Nahverkehr. Die Linie U-Bahn-Linie U5 ist nur wenige Gehminuten entfernt und ermöglicht eine direkte Verbindung in die Berliner Innenstadt. Von hier aus gelangen Sie komfortabel beispielsweise zum Alexanderplatz und damit in das pulsierende Zentrum der Hauptstadt.\n\nEin besonderes Freizeit- und Naherholungsziel in unmittelbarer Nähe sind die Gärten der Welt. Die weitläufige Parkanlage mit internationalen Themengärten, Spazierwegen und Veranstaltungen bietet vielfältige Möglichkeiten zur Erholung, für sportliche Aktivitäten oder gemeinsame Ausflüge mit der Familie.","furnishing_note":"Die Wohnung überzeugt durch eine funktionale und zugleich komfortable Ausstattung, die sowohl den Ansprüchen von Eigennutzern als auch von Kapitalanlegern gerecht wird. Auf einer Wohnfläche von etwa 60 m² verteilen sich drei gut geschnittene Zimmer, die vielseitige Nutzungsmöglichkeiten bieten und eine angenehme Wohnatmosphäre schaffen.\n\nDer Wohnbereich geht fließend in eine offene Küche über. Diese bietet ausreichend Stauraum und Arbeitsfläche für den täglichen Bedarf. In der Küche befindet sich zudem ein Waschmaschinenanschluss; eine Waschmaschine ist bereits vorhanden und kann direkt genutzt werden.\n\nDas Badezimmer ist funktional gestaltet und verfügt über eine Badewanne, die sowohl für entspannte Bäder als auch für den täglichen Komfort sorgt. Große Fensterflächen in der Wohnung sorgen insgesamt für viel Tageslicht und schaffen eine helle, freundliche Wohnatmosphäre.\n\nZusätzlichen Stauraum bietet ein zur Wohnung gehörender Kellerraum. Darüber hinaus steht den Bewohnern im Hinterhof ein gemeinschaftlich nutzbarer Garten zur Verfügung, der eine angenehme Möglichkeit zur Erholung im Freien bietet und besonders in den wärmeren Monaten zum Verweilen einlädt.","other_note":"Verkäufer ist eine Privatperson. Zeitnahe Beurkundung und Abwicklung des Kaufvertrags möglich.\n\nDiese Wohnung wird für den Käufer provisionspflichtig exklusiv über uns direkt angeboten. \nDie Vermittlungsprovision beträgt 3,57 % des notariellen Kaufpreises inkl. der gesetzlichen Mehrwertsteuer.\n\nAlle weiteren Kosten des Kaufs wie die Grunderwerbssteuer (6 %) sowie Notar- und Gerichtskosten (etwa 1,5-2 %) sind vom Käufer zu bezahlen. Die Liegenschaft wird lastenfrei übergeben.\n\nAlle Angaben sind sorgfältig recherchiert und basieren auf Angaben des Verkäufers, Irrtümer vorbehalten. Erste Kontaktaufnahme bitte per E-Mail. Wir antworten binnen weniger Stunden.\n\nSie erhalten bereits beim ersten Kontakt Zugang zum Datenraum mit weiteren Innen- und Außenaufnahmen sowie den ersten Objektunterlagen. Vollständige Adresse gerne auf Anfrage oder bei konkretem Kaufinteresse. \n\nBesichtigung ist zeitnah möglich. Sie erhalten nach qualifizierter Anfrage über das Internet-Portal bereits mögliche Besichtigungstermine angeboten. \n\nWir begleiten Sie auch gerne bei der Finanzierung.","service_charge":null,"heating_costs":null,"total_rent":null,"parking_space_price":null,"deposit":null,"courtage":"3,57% vom notariellen Kaufpreis inkl. MwSt.","courtage_note":null,"condition":"gepflegt","heating_type":"Fernwärme","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Verbrauchsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":3666,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":170000,"valuation_price_to":262000,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":34351,"salutation":"mr","academic_title":null,"first_name":"Marcel","last_name":"Smarslik","name":"Marcel Smarslik","avatar":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/MKSvHYB29Xx7MfwQ555Hvaq3/thumb_Marcel-Smarslik.png","avatar_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/MKSvHYB29Xx7MfwQ555Hvaq3/Marcel-Smarslik.png","old_crm_id":"","position":"stv. Geschäftsleitung","email":"marcel.smarslik@dydo.de","pricehubble_username":null,"phone_system_number":"0176 46142337","phone_system_numbers":[{"value":"0176 46142337","group_id":null,"position":0}],"phone":"0176 46142337","cell":"0176 46142337","public_phone":"0176 46142337","public_cell":"0176 46142337","public_email":"marcel.smarslik@dydo.de","color":"#000000","locale":"de","connected":true,"team_id":null,"department_ids":[],"abstract":null,"description":null,"custom_fields":{"qualifikation":{"value":null,"pretty_value":null}},"shop":{"id":15427,"name":"dydo Immobilien & Hausverwaltung ","color":"#2f5496","locale":"de","logo_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/logo/XuXEd9DVPkWBr3Z1VPhNG6Bf/dydo-logo-copyright.jpg","alt_logo_url":null,"watermark_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/wa