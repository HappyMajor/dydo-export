uction_year_unknown":false,"condition":"saniert","heating_type":"Fernwärme","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","energy_efficiency_value":null,"thermal_characteristic":null},"property_groups":[],"hide_address":true,"floorplans":[],"links":[],"required_fields":[{"name":"Kaltmiete","value":"2.100 €"},{"name":"Wohnfläche ca.","value":"120,4 m²"},{"name":"Zimmer","value":"4"}],"optional_fields":[{"key":"apartment_type","name":"Wohnungstyp","value":"Etagenwohnung"},{"key":"floor","name":"Etage","value":"3. OG"},{"key":"number_of_floors","name":"Etagenzahl","value":"5"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"4"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"total_rent","name":"Warmmiete","value":"2.390 €"},{"key":"service_charge","name":"Nebenkosten","value":"105 €"},{"key":"heating_costs","name":"Heizkosten","value":"185 €"},{"key":"condition","name":"Objektzustand","value":"saniert"},{"key":"last_refurbishment","name":"Letzte Modernisierung","value":2021},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"gehoben"},{"key":"balcony_space","name":"Balkon/Terrasse Fläche ca.","value":"2,6 m²"},{"key":"pets_allowed","name":"Haustiere erlaubt","value":"Nach Vereinbarung"},{"key":"cellar","name":"Keller","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"balcony","name":"Balkon / Terrasse","value":true},{"key":"bathroom","name":"Bad","value":"Wanne, Fenster"},{"key":"construction_year","name":"Baujahr ca.","value":1912},{"key":"energy_certificate_start_date","name":"Energieausweis: Ausstellungsdatum","value":"10.06.2020"},{"key":"energy_certificate_end_date","name":"Energieausweis: gültig bis","value":"09.06.2030"},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Bedarfsausweis"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"Fernwärme"},{"key":"heating_type","name":"Heizungsart","value":"Fernwärme"},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":2011}],"custom_fields":{},"description_note":"Diese großzügige Altbauwohnung überzeugt durch ihren besonderen Charme, moderne Ausstattung und ein großzügiges Raumangebot. Der Altbau wurde im Jahr 2021 vollständig saniert und verbindet den klassischen Charakter eines Altbaus mit zeitgemäßem Wohnkomfort.\n\nDie Wohnung verfügt über vier helle und gut geschnittene Zimmer sowie eine separate Küche mit hochwertiger Einbauküche. Auf einer Wohnfläche von ca. 120,4 m² bietet sie viel Platz für individuelle Wohnkonzepte. Besonders hervorzuheben ist das lichtdurchflutete Wohnzimmer mit großen Fensterflächen und direktem Zugang zum Balkon, der zusätzlichen Wohnkomfort und einen schönen Außenbereich bietet.\n\nDer durchdachte Grundriss ermöglicht eine optimale Nutzung der Wohnung. Über den geräumigen Flur sind alle Zimmer separat und bequem erreichbar. Die Wohnung verfügt über einen hochwertigen Echtholzboden, der den Räumen eine warme und elegante Atmosphäre verleiht.","location_note":"Die Wohnung befindet sich im Berliner Bezirk Steglitz. Die Lage zeichnet sich durch eine angenehme Wohnatmosphäre, eine gute Infrastruktur und eine hervorragende Anbindung an den öffentlichen Nahverkehr aus.\n\nGeschäfte des täglichen Bedarfs, Restaurants, Cafés sowie verschiedene Dienstleister befinden sich in der näheren Umgebung. Durch die gute Verkehrsanbindung sind sowohl das Berliner Stadtzentrum als auch weitere Stadtteile schnell erreichbar. Die Kombination aus ruhiger Wohnlage und urbaner Nähe macht den Standort besonders attraktiv.","furnishing_note":"- Helle Räume durch große Fensterflächen\n- Großzügiges Wohnzimmer mit direktem Balkonzugang\n- Separate Küche mit Einbauküche (EBK)\n- Modernes Badezimmer\n- Hochwertiger Echtholzboden\n- Großer Einbauschrank im Schlafzimmer\n- Waschtrockner innerhalb der Wohnung\n- Sehr geräumiger Kellerraum\n- Wohnungseingangstür mit zusätzlichem Sicherheitsschloss","other_note":"Die Wohnung wird zunächst für einen Zeitraum von vier Jahren befristet vermietet. Die monatliche Kaltmiete beträgt 2.100,00 €. Hinzu kommen Nebenkosten in Höhe von 105,00 € sowie Heizkosten in Höhe von 185,00 €, sodass sich eine monatliche Warmmiete von insgesamt 2.390,00 € ergibt. \n\nDie Versorgung mit Strom und Internet ist nicht Bestandteil der Nebenkosten und wird vom Mieter direkt mit den jeweiligen Dienstleistern abgeschlossen und abgerechnet. Zur Wohnung gehört zudem ein großzügiger Kellerraum, der zusätzlichen Stauraum bietet.","service_charge":105,"heating_costs":185,"total_rent":2390,"parking_space_price":null,"deposit":"6300€","courtage":null,"courtage_note":null,"condition":"saniert","heating_type":"Fernwärme","firing_types":"Fernwärme","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","object_type":"LIVING","rs_type":"APARTMENT","sold_date":null,"price_per_sqm":17.44,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":null,"additional_area":null,"net_floor_space":null,"broker":{"id":294787,"salutation":"mr","academic_title":null,"first_name":"Maximilian","last_name":"Aehlig","name":"Maximilian Aehlig","avatar":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/thumb_Maximilian-Aehlig.png","avatar_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/Maximilian-Aehlig.png","old_crm_id":"","position":"Vermietung/Verkauf","email":"maximilian.aehlig@dydo.de","pricehubble_username":null,"phone_system_number":"","phone_system_numbers":[{"value":"","group_id":null,"position":0}],"phone":"030 166381115","cell":"0151 40222020","public_phone":"015140222020","public_cell":"0151 40222020","public_email":"maximilian.aehlig@dydo.de","color