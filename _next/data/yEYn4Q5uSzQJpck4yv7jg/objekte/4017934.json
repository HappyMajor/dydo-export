145cb2be-127b-49d7-a392-9435501f2ab7"},{"key":"id_ph_dossier","name":"Bewertungs-ID","value":"145cb2be-127b-49d7-a392-9435501f2ab7"},{"key":"sprengnetter_dossier_link","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_link","value":"https://app.maps.sprengnetter.de/view?report_id=145cb2be-127b-49d7-a392-9435501f2ab7"},{"key":"sprengnetter_dossier_id","name":"Translation missing: de.simple_form.labels.defaults.sprengnetter_dossier_id","value":"145cb2be-127b-49d7-a392-9435501f2ab7"},{"key":"number_of_floors","name":"Etagenzahl","value":"3"},{"key":"number_of_bed_rooms","name":"Anzahl Schlafzimmer","value":"4"},{"key":"number_of_bath_rooms","name":"Anzahl Badezimmer","value":"1"},{"key":"parking_space_types","name":"Stellplatztyp","value":"Garage"},{"key":"total_rent","name":"Warmmiete","value":"2.500 €"},{"key":"service_charge","name":"Nebenkosten","value":"250 €"},{"key":"condition","name":"Objektzustand","value":"modernisiert"},{"key":"interior_quality","name":"Qualität der Ausstattung","value":"gehoben"},{"key":"usable_floor_space","name":"Nutzfläche ca.","value":"101 m²"},{"key":"garden_space","name":"Gartenfläche ca.","value":"344"},{"key":"pets_allowed","name":"Haustiere erlaubt","value":"Nach Vereinbarung"},{"key":"cellar","name":"Keller","value":true},{"key":"guest_toilet","name":"Gäste-WC","value":true},{"key":"built_in_kitchen","name":"Einbauküche","value":true},{"key":"balcony","name":"Balkon / Terrasse","value":true},{"key":"garden","name":"Garten / -mitbenutzung","value":true},{"key":"bathroom","name":"Bad","value":"Wanne, Fenster"},{"key":"construction_year","name":"Baujahr ca.","value":1967},{"key":"building_type","name":"Haustyp","value":"Reihenendhaus"},{"key":"construction_phase","name":"Bauphase","value":"Haus fertig gestellt"},{"key":"energy_certificate_start_date","name":"Energieausweis: Ausstellungsdatum","value":"28.04.2026"},{"key":"energy_certificate_end_date","name":"Energieausweis: gültig bis","value":"28.04.2036"},{"key":"building_energy_rating_type","name":"Energieausweistyp","value":"Bedarfsausweis"},{"key":"energy_efficiency_class","name":"Energieeffizienzklasse","value":"B"},{"key":"firing_types","name":"Wesentlicher Energieträger","value":"Luftwärmepumpe"},{"key":"heating_type","name":"Heizungsart","value":"Wärmepumpe"},{"key":"equipment_technology_construction_year","name":"Baujahr Anlagentechnik","value":2024},{"key":"number_of_indoor_parking_spaces","name":"Anzahl Garagenplätze","value":"1"}],"custom_fields":{},"description_note":"Zur Vermietung steht ein attraktives und gepflegtes Reihenendhaus mit ca. 101 m² Wohnfläche, welches durch eine durchdachte Raumaufteilung, viel Tageslicht und ein angenehmes Wohnambiente überzeugt. Das Haus eignet sich ideal für Paare oder kleine Familien, die ein ruhiges Zuhause mit Garten und ausreichend Platz suchen.\n\nDas Objekt verfügt über insgesamt vier Zimmer, die flexibel als Wohn-, Schlaf-, Kinder- oder Arbeitszimmer genutzt werden können. Durch die großzügigen Fensterflächen wirkt das gesamte Haus besonders hell und freundlich. Die Räume profitieren von einem natürlichen Lichteinfall, der zu einer angenehmen Wohnatmosphäre beiträgt.\n\nDer Wohnbereich bietet ausreichend Platz für eine gemütliche Sofalandschaft sowie einen Essbereich und bildet das Herzstück des Hauses. Von hier aus entsteht ein harmonischer Übergang zum Außenbereich mit Terrasse und Garten, wodurch sich insbesondere in den warmen Monaten ein sehr angenehmes Wohngefühl ergibt.\n\nEin besonderes Highlight des Hauses ist der sehr große und geräumige Keller, der vielseitige Nutzungsmöglichkeiten bietet. Neben zusätzlichem Stauraum eignet sich dieser Bereich beispielsweise auch als Hobbyraum, Hauswirtschaftsraum oder Abstellfläche für Fahrräder oder Sportgeräte. Das Gartenhäuschen bietet zusätzlich zum Keller, Platz für saisonale Gegenstände oder Gartengeräte.\n\nZum Haus gehört außerdem eine Garage, die komfortables Parken direkt am Objekt ermöglicht und zusätzlichen Schutz für Ihr Fahrzeug bietet.\n\nInsgesamt überzeugt die Immobilie durch ihre großzügige Raumgestaltung, ihre Helligkeit sowie das ruhige und familienfreundliche Wohnumfeld.","location_note":"Das Reihenendhaus befindet sich im Berliner Bezirk Lichtenrade in einer ruhigen und gepflegten Wohngegend, die überwiegend von Ein- und Zweifamilienhäusern geprägt ist.\n\nDie Lage zeichnet sich durch ihre besonders angenehme und familienfreundliche Atmosphäre aus. Verkehrsberuhigte Straßen, viel Grün sowie eine lockere Bebauung sorgen für eine hohe Wohnqualität und ein entspanntes Umfeld.\n\nIn der näheren Umgebung befinden sich verschiedene Einkaufsmöglichkeiten für den täglichen Bedarf, Supermärkte, Bäckereien sowie weitere Geschäfte. Ebenso sind Schulen, Kindergärten und Freizeitangebote gut erreichbar, was die Lage insbesondere für Familien sehr attraktiv macht.\n\nAuch die Anbindung an den öffentlichen Nahverkehr ist gegeben, sodass umliegende Stadtteile sowie die Berliner Innenstadt bequem erreichbar sind. Gleichzeitig ermöglicht die Lage eine gute Verbindung zu wichtigen Verkehrsachsen für den Individualverkehr.\n\nNeben der praktischen Infrastruktur bietet die Umgebung auch verschiedene Möglichkeiten zur Naherholung. Spaziergänge, Fahrradtouren oder entspannte Stunden im Grünen lassen sich in der Umgebung hervorragend genießen.","furnishing_note":"- vier Zimmer mit vielseitigen Nutzungsmöglichkeiten\n- großer Keller mit viel Stauraum \n- Garage \n- Badezimmer und Gäste-WC\n- vollausgestattete Einbauküche mit Elektro Geräten\n- großzügiger Garten zum entspannen\n- Gartenhäuschen zur Unterbringung von Gartenmöbeln und -geräten","other_note":"Das Reihenendhaus eignet sich ideal für Paare oder kleine Familien, die ein ruhiges Zuhause mit Garten in angenehmer Wohnlage suchen. Durch die großzügige Raumaufteilung, den großen Keller sowie den Garten mit Terrasse bietet das Haus viel Platz zum Wohnen und Entspannen. Die monatliche Kaltmiete beträgt 2.250 €, zuzüglich 250 € Nebenkosten. Der Mietvertrag wird eine Staffelmiete beinhalten, für Planungssicherheit auf beiden Seiten.\n\nBei Interesse freuen wir uns über Ihre Anfrage zur Vereinbarung eines Besichtigungstermins.","service_charge":250,"heating_costs":null,"total_rent":2500,"parking_space_price":null,"deposit":"6750€","courtage":null,"courtage_note":null,"condition":"modernisiert","heating_type":"Wärmepumpe","firing_types":"Luftwärmepumpe","energy_certificate_availability":"liegt vor","building_energy_rating_type":"Bedarfsausweis","object_type":"LIVING","rs_type":"HOUSE","sold_date":null,"price_per_sqm":22.28,"long_description_note":null,"long_location_note":null,"long_furnishing_note":null,"long_other_note":null,"valuation_price_from":null,"valuation_price_to":null,"usable_floor_space":101,"additional_area":null,"net_floor_space":null,"broker":{"id":294787,"salutation":"mr","academic_title":null,"first_name":"Maximilian","last_name":"Aehlig","name":"Maximilian Aehlig","avatar":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/thumb_Maximilian-Aehlig.png","avatar_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/avatar/yKVTK2x8ZyCf1GXpP5V5jeac/Maximilian-Aehlig.png","old_crm_id":"","position":"Vermietung/Verkauf","email":"maximilian.aehlig@dydo.de","phone_system_number":"","phone_system_numbers":[{"value":"","group_id":null,"position":0}],"phone":"030 166381115","cell":"0151 40222020","public_phone":"015140222020","public_cell":"0151 40222020","public_email":"maximilian.aehlig@dydo.de","color":null,"locale":"de","connected":true,"team_id":null,"department_ids":[],"abstract":null,"description":null,"custom_fields":{"qualifikation":{"value":null,"pretty_value":null}},"shop":{"id":15427,"name":"dydo Immobilien & Hausverwaltung ","color":"#2f5496","locale":"de","logo_url":"https://images.propstack.de/photos/XuXEd9DVPkWBr3Z1VPhNG6Bf/logo/XuXEd9DVPkWBr3Z1VPhNG6Bf/dydo-logo-copyright.jpg","alt_logo_url":null,"watermark_url